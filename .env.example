# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"

# Server
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:4300

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker Compose topology (host ports; read by docker-compose.yml)
API_HOST_PORT=8000
FRONTEND_HOST_PORT=4200
DB_HOST_PORT=5433
ADMINER_HOST_PORT=8080

# Claude via Microsoft / Azure AI Foundry (read natively by the Claude Agent SDK).
# Auth: with no key/token set, the SDK uses the Entra default credential chain (your `az login`).
# NOTE: a Docker container has no `az login` session — run the API on the host for live Claude
# calls, or pass ANTHROPIC_FOUNDRY_AUTH_TOKEN / ANTHROPIC_FOUNDRY_API_KEY into the container.
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name
ANTHROPIC_DEFAULT_SONNET_MODEL=your-sonnet-deployment-name
ANTHROPIC_DEFAULT_OPUS_MODEL=your-opus-deployment-name
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-haiku-deployment-name
JFLT_MODEL=your-sonnet-deployment-name
