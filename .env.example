# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"

# Server
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:4300

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker Compose topology (host ports; read by docker-compose.yml)
API_HOST_PORT=8000
FRONTEND_HOST_PORT=4200
DB_HOST_PORT=5433
ADMINER_HOST_PORT=8080

# Claude via the local `claude` CLI, billed to your Claude Code subscription (no API key).
# Log in once with `claude auth login` on the machine running the API.
# Model alias or id passed to `claude --model` (default: sonnet).
JFLT_MODEL=sonnet
